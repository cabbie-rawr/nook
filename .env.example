# Supabase Postgres connection string.
# Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" or "Direct connection" variant (port 5432/6543
# with pgbouncer in session mode) — NOT "Transaction pooler", which doesn't
# support the prepared statements this app's sqlx queries rely on.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Project Settings -> API.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=

# Project Settings -> API -> JWT Settings -> JWT Secret.
# Lets the backend verify Supabase-issued session tokens locally instead of
# calling out to Supabase on every request.
SUPABASE_JWT_SECRET=

# Set to production to require Secure cookies (HTTPS only).
NOOK_ENV=development
# Where uploaded attachments are stored — outside the web root, never served
# as static files, only through the authenticated download handler.
NOOK_STORAGE_DIR=./storage
